{
  "name": "oneiroi-studio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm --filter @oneiroi/web dev",
    "dev:host": "pnpm --filter @oneiroi/web dev:host",
    "preview:host": "pnpm --filter @oneiroi/web preview:host",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "check": "pnpm lint && pnpm typecheck && pnpm build"
  }
}
