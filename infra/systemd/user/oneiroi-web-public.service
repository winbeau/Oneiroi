[Unit]
Description=Oneiroi public immutable React origin
After=network-online.target oneiroi-bff-public.service
Wants=network-online.target
Requires=oneiroi-bff-public.service

[Service]
Type=simple
WorkingDirectory=%h/oneiroi-studio
EnvironmentFile=%h/.config/oneiroi/web-public.env
ExecStart=%h/oneiroi-studio/scripts/deploy-web-pi.sh --mode static --host 127.0.0.1 --port 4174 --release-sha ${ONEIROI_RELEASE_SHA} --skip-pull --skip-install --skip-build
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=%h/oneiroi-studio

[Install]
WantedBy=default.target
