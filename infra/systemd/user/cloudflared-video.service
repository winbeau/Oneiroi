[Unit]
Description=Cloudflare Tunnel for public Oneiroi
After=network-online.target oneiroi-web-public.service
Wants=network-online.target oneiroi-web-public.service

[Service]
Type=simple
Environment=HTTP_PROXY=http://127.0.0.1:10808
Environment=HTTPS_PROXY=http://127.0.0.1:10808
ExecStart=%h/.local/bin/cloudflared tunnel --config %h/.cloudflared/video.yml run
Restart=on-failure
RestartSec=10
TimeoutStopSec=20

[Install]
WantedBy=default.target
