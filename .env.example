# Local infrastructure
POSTGRES_DB=oneiroi
POSTGRES_USER=oneiroi
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
REDIS_PORT=6379

# Pi-side BFF
ONEIROI_BFF_ENVIRONMENT=development
ONEIROI_BFF_GATEWAY_BASE_URL=http://127.0.0.1:8010
ONEIROI_BFF_REQUEST_TIMEOUT_SECONDS=300
ONEIROI_BFF_MAX_UPLOAD_BYTES=20971520
ONEIROI_BFF_ACCESS_ISSUER=
ONEIROI_BFF_ACCESS_AUDIENCE=
ONEIROI_BFF_ACCESS_JWKS_URL=
ONEIROI_BFF_ACCESS_JWKS_CACHE_SECONDS=300
ONEIROI_BFF_ACCESS_CLOCK_SKEW_SECONDS=30
ONEIROI_BFF_ALLOWED_ORIGINS=https://video.icthub.top
ONEIROI_BFF_REQUIRE_INBOUND_SERVICE_AUTH=false
ONEIROI_BFF_SERVICE_PRIVATE_KEY_FILE=
ONEIROI_BFF_SERVICE_PUBLIC_KEY_FILE=
ONEIROI_BFF_SERVICE_ASSERTION_ISSUER=oneiroi-pi-bff
ONEIROI_BFF_SERVICE_ASSERTION_AUDIENCE=oneiroi-h100-gateway
ONEIROI_BFF_SERVICE_ASSERTION_KEY_ID=oneiroi-pi-1
ONEIROI_BFF_SERVICE_ASSERTION_LIFETIME_SECONDS=300
ONEIROI_BFF_SERVICE_ASSERTION_CLOCK_SKEW_SECONDS=120

# H100-side Gateway
ONEIROI_GATEWAY_ENVIRONMENT=development
ONEIROI_GATEWAY_DATABASE_URL=postgresql+asyncpg://oneiroi:change-me@127.0.0.1:5432/oneiroi
ONEIROI_GATEWAY_PERSISTENCE_ENABLED=false
ONEIROI_GATEWAY_REDIS_URL=redis://127.0.0.1:6379/0
ONEIROI_GATEWAY_REDIS_LEASES_ENABLED=false
ONEIROI_GATEWAY_REDIS_JOB_STREAMS_ENABLED=false
ONEIROI_GATEWAY_REDIS_RUNNER_BACKEND_ENABLED=false
ONEIROI_GATEWAY_REDIS_LEASE_TTL_SECONDS=300
ONEIROI_GATEWAY_COMPUTE_IDLE_TTL_SECONDS=86400
ONEIROI_GATEWAY_RUNNER_COMMAND_TIMEOUT_SECONDS=900
ONEIROI_GATEWAY_RUNNER_JOB_TIMEOUT_SECONDS=7200
ONEIROI_GATEWAY_STORAGE_ROOT=.data/storage
ONEIROI_GATEWAY_NVML_INVENTORY_ENABLED=false
ONEIROI_GATEWAY_GPU_ALLOWLIST=
ONEIROI_GATEWAY_GPU_MINIMUM_VRAM_MIB=70000
ONEIROI_GATEWAY_GPU_IDLE_VRAM_THRESHOLD_MIB=2048
ONEIROI_GATEWAY_SERVICE_PUBLIC_KEY_FILE=
ONEIROI_GATEWAY_SERVICE_ASSERTION_ISSUER=oneiroi-pi-bff
ONEIROI_GATEWAY_SERVICE_ASSERTION_AUDIENCE=oneiroi-h100-gateway
ONEIROI_GATEWAY_SERVICE_ASSERTION_CLOCK_SKEW_SECONDS=120
ONEIROI_GATEWAY_GPU_SERVER_ENABLED=false
ONEIROI_GATEWAY_GPU_SERVER_BASE_URL=http://127.0.0.1:8300
ONEIROI_GATEWAY_GPU_SERVER_SERVICE_TOKEN=
ONEIROI_GATEWAY_GPU_SERVER_REQUEST_TIMEOUT_SECONDS=7200
ONEIROI_GATEWAY_GPU_SERVER_POLL_SECONDS=0.5
ONEIROI_GATEWAY_GPU_SERVER_MAPPING_TTL_SECONDS=86400

# GPT Agent. Credential is injected only into the H100 Gateway runtime.
# The provider reference declares WebSocket support, but production remains SSE until a probe verifies it.
ONEIROI_GATEWAY_AGENT_ENABLED=false
ONEIROI_GATEWAY_AGENT_PROVIDER=openai-responses
ONEIROI_GATEWAY_AGENT_API_KEY=
ONEIROI_GATEWAY_AGENT_BASE_URL=https://api.selab.top/v1
ONEIROI_GATEWAY_AGENT_MODEL=gpt-5.6-sol
ONEIROI_GATEWAY_AGENT_REVIEW_MODEL=gpt-5.6-sol
ONEIROI_GATEWAY_AGENT_REASONING_EFFORT=xhigh
ONEIROI_GATEWAY_AGENT_STORE=false
ONEIROI_GATEWAY_AGENT_TRANSPORT=sse
ONEIROI_GATEWAY_AGENT_WEBSOCKET_ENABLED=false
ONEIROI_GATEWAY_AGENT_PROVIDER_WEBSOCKET_DECLARED=true
ONEIROI_GATEWAY_AGENT_CONNECT_TIMEOUT_SECONDS=10
ONEIROI_GATEWAY_AGENT_STREAM_TIMEOUT_SECONDS=180
ONEIROI_GATEWAY_AGENT_MAX_RUN_SECONDS=300
ONEIROI_GATEWAY_AGENT_MAX_OUTPUT_TOKENS=4000
ONEIROI_GATEWAY_AGENT_MAX_INPUT_IMAGES=4
ONEIROI_GATEWAY_AGENT_MAX_IMAGE_BYTES=20971520
ONEIROI_GATEWAY_AGENT_MAX_RETRIES=2
ONEIROI_GATEWAY_AGENT_MAX_RETRY_DELAY_SECONDS=4
ONEIROI_GATEWAY_AGENT_CAPABILITY_FILE=
ONEIROI_GATEWAY_AGENT_IMAGE_INPUT_ENABLED=false
ONEIROI_GATEWAY_AGENT_IMAGE_ENABLED=false
ONEIROI_GATEWAY_AGENT_IMAGE_MODEL=
ONEIROI_GATEWAY_AGENT_IMAGE_MODE=responses-tool

ONEIROI_GATEWAY_LTX_GIT_COMMIT=
ONEIROI_GATEWAY_LTX_DISTILLED_CHECKPOINT_PATH=
ONEIROI_GATEWAY_LTX_DISTILLED_CHECKPOINT_SHA256=
ONEIROI_GATEWAY_LTX_DEV_CHECKPOINT_PATH=
ONEIROI_GATEWAY_LTX_DEV_CHECKPOINT_SHA256=
ONEIROI_GATEWAY_LTX_DISTILLED_LORA_PATH=
ONEIROI_GATEWAY_LTX_DISTILLED_LORA_SHA256=
ONEIROI_GATEWAY_LTX_UPSAMPLER_PATH=
ONEIROI_GATEWAY_LTX_UPSAMPLER_SHA256=
ONEIROI_GATEWAY_LTX_GEMMA_ROOT=
ONEIROI_GATEWAY_LTX_GEMMA_REVISION=

# GPU runner; override per process/service unit
ONEIROI_RUNNER_ENVIRONMENT=development
ONEIROI_RUNNER_REDIS_URL=redis://127.0.0.1:6379/0
ONEIROI_RUNNER_QUEUE=fast
ONEIROI_RUNNER_NAME=runner-unconfigured
ONEIROI_RUNNER_GPU_ID=GPU-unconfigured
ONEIROI_RUNNER_PHYSICAL_INDEX=0
ONEIROI_RUNNER_HEARTBEAT_SECONDS=10
ONEIROI_RUNNER_STORAGE_ROOT=.data/storage/jobs
ONEIROI_RUNNER_ADAPTER_NAME=auto
ONEIROI_RUNNER_LOAD_TIMEOUT_SECONDS=900
ONEIROI_RUNNER_JOB_TIMEOUT_SECONDS=7200
ONEIROI_RUNNER_UNLOAD_TIMEOUT_SECONDS=30
ONEIROI_RUNNER_BASELINE_VRAM_MIB=0
ONEIROI_RUNNER_RELEASE_TOLERANCE_MIB=512

# Vite. Keep VITE_API_BASE_URL empty in same-origin deployments.
# ONEIROI_API_PROXY_TARGET is server-only; authentication is always verified by the BFF.
VITE_API_BASE_URL=
VITE_DEMO_MODE=false
ONEIROI_API_PROXY_TARGET=http://127.0.0.1:8000
