# Local infrastructure
POSTGRES_DB=oneiroi
POSTGRES_USER=oneiroi
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
REDIS_PORT=6379

# Pi-side BFF
ONEIROI_BFF_ENVIRONMENT=development
ONEIROI_BFF_GATEWAY_BASE_URL=http://127.0.0.1:8010
ONEIROI_BFF_REQUEST_TIMEOUT_SECONDS=300
ONEIROI_BFF_MAX_UPLOAD_BYTES=20971520

# H100-side Gateway
ONEIROI_GATEWAY_ENVIRONMENT=development
ONEIROI_GATEWAY_DATABASE_URL=postgresql+asyncpg://oneiroi:change-me@127.0.0.1:5432/oneiroi
ONEIROI_GATEWAY_PERSISTENCE_ENABLED=false
ONEIROI_GATEWAY_REDIS_URL=redis://127.0.0.1:6379/0
ONEIROI_GATEWAY_REDIS_LEASES_ENABLED=false
ONEIROI_GATEWAY_REDIS_JOB_STREAMS_ENABLED=false
ONEIROI_GATEWAY_REDIS_RUNNER_BACKEND_ENABLED=false
ONEIROI_GATEWAY_REDIS_LEASE_TTL_SECONDS=300
ONEIROI_GATEWAY_COMPUTE_IDLE_TTL_SECONDS=86400
ONEIROI_GATEWAY_RUNNER_COMMAND_TIMEOUT_SECONDS=900
ONEIROI_GATEWAY_RUNNER_JOB_TIMEOUT_SECONDS=7200
ONEIROI_GATEWAY_STORAGE_ROOT=.data/storage
ONEIROI_GATEWAY_NVML_INVENTORY_ENABLED=false
ONEIROI_GATEWAY_GPU_ALLOWLIST=
ONEIROI_GATEWAY_GPU_MINIMUM_VRAM_MIB=70000
ONEIROI_GATEWAY_GPU_IDLE_VRAM_THRESHOLD_MIB=2048
ONEIROI_GATEWAY_LTX_GIT_COMMIT=
ONEIROI_GATEWAY_LTX_DISTILLED_CHECKPOINT_PATH=
ONEIROI_GATEWAY_LTX_DISTILLED_CHECKPOINT_SHA256=
ONEIROI_GATEWAY_LTX_DEV_CHECKPOINT_PATH=
ONEIROI_GATEWAY_LTX_DEV_CHECKPOINT_SHA256=
ONEIROI_GATEWAY_LTX_DISTILLED_LORA_PATH=
ONEIROI_GATEWAY_LTX_DISTILLED_LORA_SHA256=
ONEIROI_GATEWAY_LTX_UPSAMPLER_PATH=
ONEIROI_GATEWAY_LTX_UPSAMPLER_SHA256=
ONEIROI_GATEWAY_LTX_GEMMA_ROOT=
ONEIROI_GATEWAY_LTX_GEMMA_REVISION=

# GPU runner; override per process/service unit
ONEIROI_RUNNER_ENVIRONMENT=development
ONEIROI_RUNNER_REDIS_URL=redis://127.0.0.1:6379/0
ONEIROI_RUNNER_QUEUE=fast
ONEIROI_RUNNER_NAME=runner-unconfigured
ONEIROI_RUNNER_GPU_ID=GPU-unconfigured
ONEIROI_RUNNER_PHYSICAL_INDEX=0
ONEIROI_RUNNER_HEARTBEAT_SECONDS=10
ONEIROI_RUNNER_STORAGE_ROOT=.data/storage/jobs
ONEIROI_RUNNER_ADAPTER_NAME=auto
ONEIROI_RUNNER_LOAD_TIMEOUT_SECONDS=900
ONEIROI_RUNNER_JOB_TIMEOUT_SECONDS=7200
ONEIROI_RUNNER_UNLOAD_TIMEOUT_SECONDS=30
ONEIROI_RUNNER_BASELINE_VRAM_MIB=0
ONEIROI_RUNNER_RELEASE_TOLERANCE_MIB=512

# Vite. Keep empty in same-origin deployments; use the dev proxy by default.
VITE_API_BASE_URL=
VITE_DEMO_MODE=false
